<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:isLightTheme">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#1A73E8</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">false</item>
    </style>

    <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:isLightTheme">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#6E9DD8</item>
        <item name="android:colorBackground">#1B1D20</item>
        <item name="android:textColorPrimary">#E8EAED</item>
        <item name="android:textColorSecondary">#9AA0A6</item>
        <item name="android:navigationBarColor">#1B1D20</item>
        <item name="android:statusBarColor">#1B1D20</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:alertDialogTheme">@style/MedianAlertDialogDark</item>
    </style>

    <!-- Runtime overlays: WebView reads isLightTheme when choosing prefers-color-scheme. -->
    <style name="AppThemeSignalLight">
        <item name="android:isLightTheme">true</item>
        <item name="android:colorAccent">#1A73E8</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:textColorPrimary">#202124</item>
        <item name="android:textColorSecondary">#5F6368</item>
        <item name="android:alertDialogTheme">@style/MedianAlertDialogLight</item>
    </style>

    <style name="AppThemeSignalDark">
        <item name="android:isLightTheme">false</item>
        <item name="android:colorAccent">#6E9DD8</item>
        <item name="android:colorBackground">#1B1D20</item>
        <item name="android:textColorPrimary">#E8EAED</item>
        <item name="android:textColorSecondary">#9AA0A6</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:alertDialogTheme">@style/MedianAlertDialogDark</item>
    </style>

    <style name="MedianAlertDialogLight" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#1A73E8</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:textColorPrimary">#202124</item>
        <item name="android:textColorSecondary">#5F6368</item>
    </style>

    <style name="MedianAlertDialogDark" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#6E9DD8</item>
        <item name="android:colorBackground">#23262A</item>
        <item name="android:textColorPrimary">#E8EAED</item>
        <item name="android:textColorSecondary">#9AA0A6</item>
    </style>
</resources>
