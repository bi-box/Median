<resources>
    <!-- Keep framework attributes newer than minSdk in their versioned resource folders. -->
    <style name="AppTheme" parent="AppThemeBase" />
    <style name="AppThemeDark" parent="AppThemeDarkBase" />
    <style name="AppThemeSignalLight" parent="AppThemeSignalLightBase" />
    <style name="AppThemeSignalDark" parent="AppThemeSignalDarkBase" />
    <style name="MedianAlertDialogLight" parent="MedianAlertDialogLightBase" />
    <style name="MedianAlertDialogDark" parent="MedianAlertDialogDarkBase" />

    <style name="AppThemeBase" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/accent_primary</item>
        <item name="android:colorPrimary">@color/accent_primary</item>
        <item name="android:colorBackground">@color/surface_0_light</item>
        <item name="android:textColorPrimary">@color/text_primary_light</item>
        <item name="android:textColorSecondary">@color/text_secondary_light</item>
        <item name="android:navigationBarColor">@color/surface_0_light</item>
        <item name="android:statusBarColor">@color/surface_0_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowBackground">@color/surface_0_light</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:alertDialogTheme">@style/MedianAlertDialogLight</item>
    </style>

    <style name="AppThemeDarkBase" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/accent_primary</item>
        <item name="android:colorPrimary">@color/accent_primary</item>
        <item name="android:colorBackground">@color/surface_0_dark</item>
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>
        <item name="android:navigationBarColor">@color/surface_0_dark</item>
        <item name="android:statusBarColor">@color/surface_0_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowBackground">@color/surface_0_dark</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:alertDialogTheme">@style/MedianAlertDialogDark</item>
    </style>

    <!-- Runtime overlays only update the WebView color-scheme signal. Applying the complete
         AppTheme/AppThemeDark parent at runtime also replaces native drawables and causes a
         mixed white-panel/dark-row sheet on Android versions that re-resolve theme attributes. -->
    <style name="AppThemeSignalLightBase">
        <item name="android:alertDialogTheme">@style/MedianAlertDialogLight</item>
    </style>

    <style name="AppThemeSignalDarkBase">
        <item name="android:alertDialogTheme">@style/MedianAlertDialogDark</item>
    </style>

    <style name="MedianAlertDialogLightBase" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/accent_primary</item>
        <item name="android:colorBackground">@color/surface_0_light</item>
        <item name="android:textColorPrimary">@color/text_primary_light</item>
        <item name="android:textColorSecondary">@color/text_secondary_light</item>
    </style>

    <style name="MedianAlertDialogDarkBase" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/accent_primary</item>
        <item name="android:colorBackground">@color/surface_1_dark</item>
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>
    </style>
</resources>
